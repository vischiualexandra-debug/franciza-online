# Lista variabilelor de mediu. Valorile reale se pun DOAR în Vercel → Settings → Environment Variables
# (sau local în .env.local, care nu se publică nicăieri). În acest fișier NU se pun valori reale.

# Supabase → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram: tokenul de la @BotFather și ID-ul chatului tău
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Opțional) trimite cererile și în franciza-crm, coloana „Cereri”
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Panoul admin: parola pentru crearea primului administrator + cheia sesiunilor (minim 32 de caractere)
ADMIN_PASSWORD=
AUTH_SECRET=
